# ════════════════════════════════════════════════════
#  Enterprise RAG — Client Configuration
#  Copy this to .env and fill in your values
# ════════════════════════════════════════════════════

# ── Qdrant (leave as-is — internal Docker network) ──
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=enterprise_docs

# ── LM Studio ───────────────────────────────────────
# Set this to the IP of the machine running LM Studio.
# In LM Studio: Settings → enable "Listen on local network"
# Example: your LM Studio machine is at 192.168.1.50
LMSTUDIO_BASE_URL=http://192.168.1.50:1234
LMSTUDIO_MODEL=your-model-name-here

# ── Admin credentials (CHANGE THESE) ────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password

# ── JWT Secret ───────────────────────────────────────
# Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_generated_secret_here

# ── Widget Settings ──────────────────────────────────
# Set to true to show a Name/Phone/Email form before users can chat.
# Set to false to let users chat directly without entering details.
COLLECT_USER_DETAILS=false

# ── Limits ───────────────────────────────────────────
MAX_FILE_SIZE_MB=50